# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
MONGODB_URI=mongodb://localhost:27017/qa-test-hub

# Autenticação
# Gere um segredo próprio: openssl rand -base64 32
JWT_SECRET=troque-este-valor-por-um-segredo-gerado-localmente
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# LLM — usado apenas pela rota POST /runs/:id/comment-draft
# Provedor e modelo pendentes de definição conforme política interna de uso de IA
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
